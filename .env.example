# Copy this file to ".env" and fill in what you need. ".env" is never uploaded.

# Password needed to open the library. Strongly recommended if anyone else
# can reach the server. (It can also be set later in Settings.)
APP_PASSWORD=

# Optional: only for Spotify playlists longer than 100 tracks.
# Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
